@startuml
title CRM ИТ Школы РТК — роли и варианты использования

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Менеджер\n(manager)" as Manager
actor "Руководитель\n(head)" as Head
actor "Администратор\n(admin)" as Admin
actor Keycloak
actor "LMS" as LMS
actor "Сайт ИТ Школы" as Site

rectangle "CRM взаимодействия с вузами" {
  usecase "Авторизоваться" as UC_Login

  package "Операционная работа" {
    usecase "Просматривать доступные\nвзаимодействия и вузы" as UC_View
    usecase "Создать взаимодействие\nпо доступному вузу" as UC_Create
    usecase "Вести workflow" as UC_Workflow
    usecase "Добавлять комментарии\nи файлы" as UC_Content
    usecase "Вести контакты, программы,\nпродукты и договор" as UC_Data
    usecase "Формировать отчёты\nв своей области данных" as UC_Report
    usecase "Смотреть агрегированную\nстатистику обучения" as UC_Stats
  }

  package "Управление работой" {
    usecase "Просматривать взаимодействия\nподчинённой области" as UC_All
    usecase "Назначать и менять\nответственных" as UC_Assign
    usecase "Контролировать проблемы\nи сроки" as UC_Control
    usecase "Формировать сводные\nотчёты" as UC_Summary
    usecase "Выполнить разрешённое\nисключение workflow" as UC_Override
    usecase "Просматривать персональные\nданные заявок" as UC_PII
  }

  package "Администрирование платформы" {
    usecase "Управлять пользователями,\nролями и областями доступа" as UC_Users
    usecase "Вести справочники" as UC_Catalog
    usecase "Загружать XLS/XLSX" as UC_Import
    usecase "Настраивать шаблоны\nи версии workflow" as UC_Templates
    usecase "Настраивать и запускать\nинтеграции" as UC_Integration
    usecase "Настраивать систему" as UC_Settings
    usecase "Просматривать аудит" as UC_Audit
  }

  usecase "Передать данные\nпо API" as UC_API
}

Manager --> UC_Login
Manager --> UC_View
Manager --> UC_Create
Manager --> UC_Workflow
Manager --> UC_Content
Manager --> UC_Data
Manager --> UC_Report
Manager --> UC_Stats

Head --> UC_Login
Head --> UC_All
Head --> UC_Assign
Head --> UC_Control
Head --> UC_Summary
Head --> UC_Override
Head --> UC_PII

Admin --> UC_Login
Admin --> UC_Users
Admin --> UC_Catalog
Admin --> UC_Import
Admin --> UC_Templates
Admin --> UC_Integration
Admin --> UC_Settings
Admin --> UC_Audit

Keycloak --> UC_Login
LMS --> UC_API
Site --> UC_API
UC_Integration ..> UC_API : <<include>>

note bottom of Admin
  Администратор не наследует автоматически
  права менеджера и руководителя. Доступ к бизнес-
  данным выдаётся отдельно и журналируется.
end note

note bottom of Head
  Область данных руководителя: команда
  или все взаимодействия — по настройке.
end note

@enduml
