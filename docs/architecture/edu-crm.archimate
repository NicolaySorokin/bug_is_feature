<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="EDU CRM - взаимодействие ИТ Школы Ростелекома с вузами" id="id-30b6bda7313b5c84b1162694620a182d" version="5.0.0">
  <folder name="Strategy" id="id-4ea08c6e294c5b7d8a183c7e5cd92b9e" type="strategy"/>
  <folder name="Business" id="id-d44140901c3b5f2b95edf1e5e2a4b4ca" type="business">
    <element xsi:type="archimate:BusinessActor" name="Менеджер" id="id-65ad863a8b735cbfba2435a2156770f4">
      <documentation>Ведёт свои взаимодействия с вузами</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Руководитель" id="id-d04a64cba9ff511d9218dacb2fe52746">
      <documentation>Команда менеджеров: ответственные, блокировки, исключения, проверка вузов</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Администратор" id="id-03d7eecf90f95e5994e9d188b53f42be">
      <documentation>Права, справочники, шаблоны процессов, обмен; без бизнес-данных</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Системный администратор" id="id-5a4e504917b25107ac9174978e52feb6">
      <documentation>Установка, обновление, резервные копии</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Вуз / школа" id="id-9298f85ffe2c5914b02351ee47222aec">
      <documentation>Партнёр ИТ Школы</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Взаимодействие с вузом (14 этапов)" id="id-37b60d8e1f4e5bb2b608b78a73f3ac3e">
      <documentation>Поиск контактов → ... → Итоговый контроль; шаблон процесса с версиями</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Отчётность по взаимодействию и обучению" id="id-e8d36bc88c195261afc6c3725e29434f"/>
    <element xsi:type="archimate:BusinessObject" name="Взаимодействие с вузом" id="id-b44b4892e2b55331a71432966f390a0c">
      <documentation>Центральный объект: вуз, ответственный, статус и результат, процесс, программы и продукты, контакты, файлы</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Договор (0..1)" id="id-14b9839f7fde5adf832ffde1b4e5bbb9">
      <documentation>Необязательная часть взаимодействия: подписание, сроки, статус, лицензии</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="ИТ-программа" id="id-a4dfd862317a5b43b3720128ac58755a"/>
    <element xsi:type="archimate:BusinessObject" name="ИТ-продукт и лицензия" id="id-89c6733603a35e72888d54cfd79bbda7"/>
    <element xsi:type="archimate:BusinessObject" name="Заявка на обучение" id="id-a2f975d68a2e5f708d5cb7f3ceaa8eb7">
      <documentation>С сайта ИТ Школы</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Обучающийся" id="id-d70e9ff7687a5af4825afb6d82b09895">
      <documentation>Из LMS; персональные данные минимизированы</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-3e76f58c2ab750d7b60f20d1d3d43dbe" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Клиентская часть (React SPA)" id="id-c861a7a379095fb793ac9fde23639099">
      <documentation>Дизайн-система Atomaro, тема Ростелекома</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="EDU CRM API (FastAPI)" id="id-33238023829c5d168a7f5cd851089372">
      <documentation>REST /api/v1, OpenAPI /docs</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Keycloak (реалм edu-crm)" id="id-a13da9481b995be599ff92fed70e6585">
      <documentation>OIDC, PKCE, роли manager/head/admin</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="LMS ИТ Школы" id="id-9fe8aed15b6654d2ba083b4716b30b1d">
      <documentation>Внешняя система</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Сайт ИТ Школы" id="id-3e6b665027c857fcb23711353c77a968">
      <documentation>Внешняя система</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Взаимодействия, вузы, программы и продукты, договоры" id="id-5b74c472208f54878a6db423b67177e8"/>
    <element xsi:type="archimate:ApplicationService" name="Рабочий процесс: переходы, комментарии, файлы" id="id-c5b2df434f78574e8c87dc4de851f82f"/>
    <element xsi:type="archimate:ApplicationService" name="Отчёты и диаграммы (XLSX, XLS, PDF, PNG, JSON)" id="id-68d999d6c71155028cdc99067c6df949"/>
    <element xsi:type="archimate:ApplicationService" name="Статистика обучения" id="id-d4e5fd70e2aa5c6ea8d2dc270d881842"/>
    <element xsi:type="archimate:ApplicationService" name="Загрузка каталогов из Excel" id="id-9884605eaa835fb18a3da48e27c2e54c"/>
    <element xsi:type="archimate:ApplicationService" name="Обмен с LMS и сайтом" id="id-6e6e900257805947a37c4cde12e3a64e"/>
    <element xsi:type="archimate:ApplicationService" name="Пользователи, права, журнал, настройки" id="id-f4f97c83119e5ff4aa7eb60f3961f155"/>
    <element xsi:type="archimate:ApplicationService" name="Вход и роли" id="id-8557fca31ce159359bc73c065999f832"/>
    <element xsi:type="archimate:DataObject" name="Данные CRM" id="id-98bb95308858582e815b9307f2aa0d7d">
      <documentation>Взаимодействия, процессы, договоры, справочники, журнал изменений</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Файлы вложений" id="id-3400a8d1fc865c96a0f1f00c80809aea">
      <documentation>PNG, JPEG, PDF, ZIP, GZIP, RAR, DOC(X), XLS(X)</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-48b2c029b8325f3a8bc51b5b1fd4d80a" type="technology">
    <element xsi:type="archimate:Node" name="Сервер Linux (4 ГБ, Docker Compose)" id="id-88df8729a88b54a5886f235f39fa85b2"/>
