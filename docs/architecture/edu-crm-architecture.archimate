<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="CRM" id="id-3a5b2bc12f6d5200852b0e2af35f1c72" version="5.0.0">
  <folder name="Strategy" id="id-29bd6cdfa6eb483a9216812b98a65304" type="strategy"/>
  <folder name="Business" id="id-80fe1eee15dd5df8ae7e0e9a35fd9d2c" type="business">
    <element xsi:type="archimate:BusinessProcess" name="Вести взаимодействие с вузом" id="id-829395582a9359189ea38be55570a1c1">
      <documentation>Базовый процесс; 14 шагов описаны отдельно.</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-86adb045f8c35a8d9264b07b575a1798" type="application">
    <element xsi:type="archimate:ApplicationService" name="Ведение взаимодействий" id="id-1b20b455b8cb5e9ebb0311b8a120f399">
      <documentation>Карточки, статусы, комментарии и файлы.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Управление процессом" id="id-a17d2a35da005f15896425bb375bff86">
      <documentation>Шаблоны и переходы workflow.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Контроль проблем и сроков" id="id-96e83033e1d856b59f6ab61262207e84">
      <documentation>Просрочки и события, требующие внимания.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Отчётность и статистика" id="id-2e06d56c12e1567b88a277e494d6c7a3">
      <documentation>Отчёты, выборки и графики.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Ведение справочников" id="id-58a9af550f3856cb92930d06535123c0">
      <documentation>Каталоги и импорт XLS/XLSX.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Обмен с LMS и сайтом" id="id-97a5f3943faa516baa57ebc147af6fa9">
      <documentation>Получение и обработка данных внешних систем.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Управление доступом" id="id-05b63a0163a4551d9e892a0e1a7a31b7">
      <documentation>Права пользователей на данные и действия CRM.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Веб-клиент React" id="id-878e03a224ad5d739004444205c10728">
      <documentation>Пользовательский интерфейс CRM; в стенде раздаётся Nginx.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="API FastAPI" id="id-4094f375882e5a2d88666822fcbc9964">
      <documentation>Модульный монолит; REST /api/v1.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Keycloak" id="id-4878db59287d5263919d1bcf4df6fed7">
      <documentation>Отдельный сервис авторизации OIDC.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="LMS ИТ Школы" id="id-7f1bec12325659e9bd83d116ed548086">
      <documentation>Внешний источник учебных данных.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Сайт ИТ Школы" id="id-df938474af2b51c793e92e40a7fb2f68">
      <documentation>Внешний источник заявок на обучение.</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-e639419221f654119c561bbffe93ca45" type="technology">
    <element xsi:type="archimate:SystemSoftware" name="PostgreSQL 16" id="id-31806cee905454f4800694e9a58e0e8a">
      <documentation>Базы CRM и Keycloak в одном сервере PostgreSQL.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="Файлы вложений" id="id-a884c38902bd577bbb5236561e9d9fad">
      <documentation>Хранятся в томе api_storage.</documentation>
    </element>
  </folder>
