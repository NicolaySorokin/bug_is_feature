{
  "realm": "edu-crm",
  "displayName": "ИТ Школа Ростелекома — CRM",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600,
  "loginTheme": "edu-crm",
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and notUsername(undefined) and passwordHistory(3)",
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru"
  ],
  "defaultLocale": "ru",
  "roles": {
    "realm": [
      {
        "name": "manager",
        "description": "Менеджер (КАМ): свои взаимодействия с вузами - процесс, состав, договор, файлы"
      },
      {
        "name": "head",
        "description": "Руководитель: взаимодействия команды, назначение ответственных, исключения, подтверждение вузов. Права менеджера не включает"
      },
      {
        "name": "admin",
        "description": "Администратор: пользователи, роли и права, справочники, шаблоны процессов, импорт, интеграции, настройки. Бизнес-данные не видит без выданной области. Включает права realm-management на пользователей: CRM меняет роли через Admin API Keycloak с токеном администратора.",
        "composite": true,
        "composites": {
          "client": {
            "realm-management": [
              "view-users",
              "manage-users",
              "query-users",
              "view-realm"
            ]
          }
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "edu-crm-api",
      "name": "EDU CRM API",
      "description": "Серверная часть. Токены проверяются по JWKS реалма, аудитория — этот клиент.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "edu-crm-web",
      "name": "EDU CRM Web",
      "description": "Клиентская часть: публичный клиент, Authorization Code + PKCE. Адреса возврата задаёт scripts/keycloak_setup.py по CORS_ORIGINS среды.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*",
        "https://edu-crm.nikitarodionov.ru/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "edu-crm-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "edu-crm-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "edu-crm-loadtest",
      "name": "EDU CRM Load test",
      "description": "Только для make loadtest: вход по паролю без страницы Keycloak. Выключен; включается на время замера: python -m scripts.keycloak_setup --loadtest on.",
      "enabled": false,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "edu-crm-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "edu-crm-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
