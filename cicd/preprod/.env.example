# Переменные предпродуктивной среды. Скопируйте в cicd/preprod/.env и задайте
# настоящие значения, в репозиторий файл не попадает.

HTTP_PORT=80

# Пароль базы обязателен: значения по умолчанию на стенде недопустимы
POSTGRES_USER=edu_crm
POSTGRES_PASSWORD=замените-на-длинный-пароль
POSTGRES_DB=edu_crm
POSTGRES_PORT=5432

# Авторизация только через Keycloak
AUTH_BACKEND=keycloak
KEYCLOAK_ADMIN=admin
# Пароль консоли Keycloak. Длинный, с заглавными и строчными буквами
# и цифрами: на новом реалме им же первый раз входит admin
KEYCLOAK_ADMIN_PASSWORD=замените-на-длинный-пароль
# Адрес, по которому Keycloak виден снаружи: он попадает в токен
KEYCLOAK_BASE_URL=http://preprod.example.ru
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=edu-crm
KEYCLOAK_AUDIENCE=edu-crm-api
# Стенд работает по HTTP: Keycloak не должен требовать HTTPS снаружи
KEYCLOAK_SSL_REQUIRED=none

# Необязательно: начальные пароли пользователей, логин:пароль через запятую.
# Ставятся только тем, у кого пароля нет. Без них первый вход admin по паролю
# консоли Keycloak. Сгенерировать: python -m scripts.keycloak_setup --generate-passwords
# KEYCLOAK_USER_PASSWORDS=petrov:...,orlova:...,admin:...

# Адрес интерфейса: откуда разрешены запросы к API и куда Keycloak
# возвращает после входа
CORS_ORIGINS=http://preprod.example.ru

# Адреса внешних систем. Если пусто, работают тестовые ответы адаптеров
LMS_BASE_URL=
LMS_TOKEN=
SITE_BASE_URL=
SITE_TOKEN=
# Обмен по расписанию раз в N часов, 0 только вручную. Администратор меняет
# в «Настройках»
INTEGRATION_SYNC_INTERVAL_HOURS=0
