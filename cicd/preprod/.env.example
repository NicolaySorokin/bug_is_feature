# Переменные предпродуктивной среды. Скопируйте в cicd/preprod/.env
# на сервере и задайте настоящие значения. Файл .env в репозиторий
# не попадает - он в .gitignore.

HTTP_PORT=80

# Пароль базы обязателен: значения по умолчанию на стенде недопустимы
POSTGRES_USER=edu_crm
POSTGRES_PASSWORD=замените-на-длинный-пароль
POSTGRES_DB=edu_crm
POSTGRES_PORT=5432

# Авторизация только через Keycloak
AUTH_BACKEND=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=замените-на-длинный-пароль
# Адрес, по которому Keycloak виден снаружи: он попадает в токен
KEYCLOAK_BASE_URL=http://preprod.example.ru
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=edu-crm
KEYCLOAK_AUDIENCE=edu-crm-api

# Откуда разрешены запросы клиентской части
CORS_ORIGINS=http://preprod.example.ru

# Адреса внешних систем. Пусто - работают тестовые ответы адаптеров
LMS_BASE_URL=
LMS_TOKEN=
SITE_BASE_URL=
SITE_TOKEN=
