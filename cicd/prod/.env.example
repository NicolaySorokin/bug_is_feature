# Переменные боевой среды, на сервере это секрет PROD_ENV. Для запуска вручную
# скопируйте в cicd/prod/.env. Пароли не должны совпадать с предпродуктивными.

# Пароль базы: длинный, случайный, хранится только на сервере
POSTGRES_USER=edu_crm
POSTGRES_PASSWORD=замените-на-длинный-пароль
POSTGRES_DB=edu_crm

# Авторизация только через Keycloak
AUTH_BACKEND=keycloak
KEYCLOAK_ADMIN=admin
# Пароль консоли Keycloak. Длинный, с заглавными и строчными буквами
# и цифрами: на новом реалме им же первый раз входит admin
KEYCLOAK_ADMIN_PASSWORD=замените-на-длинный-пароль
KEYCLOAK_BASE_URL=https://edu-crm.nikitarodionov.ru
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=edu-crm
KEYCLOAK_AUDIENCE=edu-crm-api

# Необязательно: начальные пароли пользователей, логин:пароль через запятую.
# Ставятся только тем, у кого пароля нет. На боевом стенде это отдельный
# секрет репозитория KEYCLOAK_USER_PASSWORDS.
# Сгенерировать: python -m scripts.keycloak_setup --generate-passwords
# KEYCLOAK_USER_PASSWORDS=petrov:...,orlova:...,admin:...

# Сколько процессов у API. 4 процесса под нагрузкой из ТЗ занимают около 550 МБ,
# при нехватке памяти уменьшите до 2
WEB_CONCURRENCY=4

# Сколько выгрузок собирает каждый процесс API одновременно. На 2 vCPU больше 1
# не ставьте, иначе выгрузки начнут отнимать процессор у интерфейса
EXPORT_CONCURRENCY=1

# Каталог сертификатов Let's Encrypt на хосте и webroot для проверок при продлении
CERTS_DIR=/etc/letsencrypt
CERTBOT_WEBROOT=/var/www/certbot

CORS_ORIGINS=https://edu-crm.nikitarodionov.ru

# Адреса внешних систем заказчика
LMS_BASE_URL=
LMS_TOKEN=
SITE_BASE_URL=
SITE_TOKEN=
# Обмен по расписанию раз в N часов, 0 только вручную. Администратор меняет
# в «Настройках»
INTEGRATION_SYNC_INTERVAL_HOURS=0
