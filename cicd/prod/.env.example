# Переменные боевой среды. На сервере это содержимое секрета PROD_ENV:
# деплой кладёт его в /opt/edu-crm/shared/prod.env и собирает из него
# cicd/prod/.env релиза, дописывая API_IMAGE_TAG, WEB_IMAGE_TAG,
# NGINX_CONF_SHA и KEYCLOAK_REALM_SHA. Для запуска вручную скопируйте
# в cicd/prod/.env.
# Файл .env в репозиторий не попадает.
#
# Пароли не должны совпадать с предпродуктивными: это разные контуры.

# Пароль базы: длинный, случайный, хранится только на сервере
POSTGRES_USER=edu_crm
POSTGRES_PASSWORD=замените-на-длинный-пароль
POSTGRES_DB=edu_crm

# Авторизация только через Keycloak
AUTH_BACKEND=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=замените-на-длинный-пароль
KEYCLOAK_BASE_URL=https://edu-crm.nikitarodionov.ru
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=edu-crm
KEYCLOAK_AUDIENCE=edu-crm-api

# Сколько рабочих процессов у API. 4 процесса под нагрузкой из ТЗ занимают
# ~550 МБ; если деплой предупреждает о нехватке памяти - уменьшите до 2
WEB_CONCURRENCY=4

# Сколько выгрузок (PDF, XLSX, диаграммы) каждый процесс API собирает
# одновременно, остальные ждут в очереди. На 2 vCPU больше 1 не ставьте:
# тяжёлые выгрузки начнут отнимать процессор у интерфейса
EXPORT_CONCURRENCY=1

# Каталог с сертификатами Let's Encrypt на хосте и каталог, куда certbot
# кладёт проверочные файлы при продлении (Nginx отдаёт их по HTTP)
CERTS_DIR=/etc/letsencrypt
CERTBOT_WEBROOT=/var/www/certbot

CORS_ORIGINS=https://edu-crm.nikitarodionov.ru

# Адреса внешних систем заказчика
LMS_BASE_URL=
LMS_TOKEN=
SITE_BASE_URL=
SITE_TOKEN=
