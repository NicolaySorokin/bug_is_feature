# Переменные среды разработки. Скопируйте в cicd/dev/.env, если нужно
# отойти от значений по умолчанию: без файла стенд поднимется и так.

# Порты, которые видны на вашей машине
API_PORT=8000
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080

# dev: заглушка авторизации по заголовкам, keycloak: настоящие токены
AUTH_BACKEND=dev

# Печатать каждый SQL-запрос в лог
DB_ECHO=false

POSTGRES_USER=edu_crm
POSTGRES_PASSWORD=edu_crm
POSTGRES_DB=edu_crm

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
