# Скопируйте в backend/.env для локального запуска без Docker.

ENVIRONMENT=dev

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=edu_crm
POSTGRES_PASSWORD=edu_crm
POSTGRES_DB=edu_crm
# Печатать каждый SQL-запрос в лог
DB_ECHO=false

# dev - заглушка авторизации, keycloak - проверка Bearer-токена
AUTH_BACKEND=dev

# Внешний адрес Keycloak попадает в токен и проверяется как издатель,
# внутренний нужен для получения ключей реалма (в Docker это разные адреса)
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_REALM=edu-crm
KEYCLOAK_AUDIENCE=edu-crm-api

# Пользователь заглушки по умолчанию
DEV_USER_USERNAME=dev
DEV_USER_FULL_NAME=Разработчик
DEV_USER_EMAIL=dev@example.com
DEV_USER_ROLES=manager,head,admin

# Внешние системы. Пока адрес пуст, адаптер отвечает тестовыми данными
# из backend/app/services/integrations/fixtures.
LMS_BASE_URL=
LMS_TOKEN=
SITE_BASE_URL=
SITE_TOKEN=
INTEGRATION_TIMEOUT_SECONDS=15

# Файлы: каталог хранилища и предельный размер загрузки
STORAGE_DIR=storage
MAX_UPLOAD_MB=25

# Контроль проблемных процессов: норма простоя этапа, если у этапа
# не задан свой sla_days, и запас до окончания сроков
ALERT_DEFAULT_SLA_DAYS=14
ALERT_EXPIRING_DAYS=60

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
