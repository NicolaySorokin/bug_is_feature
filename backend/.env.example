# Скопируйте в backend/.env для локального запуска без Docker.

ENVIRONMENT=dev

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=edu_crm
POSTGRES_PASSWORD=edu_crm
POSTGRES_DB=edu_crm
# Печатать каждый SQL-запрос в лог
DB_ECHO=false

# dev - заглушка авторизации, keycloak - проверка Bearer-токена
AUTH_BACKEND=dev

KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=edu-crm
KEYCLOAK_AUDIENCE=edu-crm-api

# Пользователь заглушки по умолчанию
DEV_USER_USERNAME=dev
DEV_USER_FULL_NAME=Разработчик
DEV_USER_EMAIL=dev@example.com
DEV_USER_ROLES=manager,head,admin

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
STORAGE_DIR=storage
