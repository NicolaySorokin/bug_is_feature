{
  "name": "edu-crm-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "api:types": "openapi-typescript ../docs/openapi.json --default-non-nullable false -o src/api/schema.d.ts",
    "theme": "node scripts/rt-theme.mjs",
    "help:screenshots": "node scripts/help-screenshots.cjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@atomaro/ui-kit": "^0.1.3",
    "@fontsource/manrope": "^5.3.0",
    "@tanstack/react-query": "^5.103.2",
    "keycloak-js": "^26.2.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.5.3"
  }
}
